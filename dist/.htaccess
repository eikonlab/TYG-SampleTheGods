# .htaccess — RÉGLAGES DU SERVEUR (Infomaniak / Apache)
# Copié tel quel dans dist/ par `npm run build`.

# Pas de liste des fichiers quand on ouvre un dossier
Options -Indexes

# Bons types pour les médias
AddType image/webp .webp
AddType video/mp4 .mp4 .m4v
AddType audio/mp4 .m4a
AddType video/quicktime .mov

# Compression du texte (html, css, js, json, svg)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Cache navigateur
<IfModule mod_headers.c>
  # La page : toujours revérifiée (pour voir tout de suite une nouvelle version)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS, CSS, extraits audio : leur nom change à chaque build (assets/xxx-AbC123.js) → gardés 1 an
  <FilesMatch "\.(js|css|m4a)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos et vidéos : gardées 30 jours
  <FilesMatch "\.(webp|jpe?g|png|gif|mp4|m4v|mov)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
